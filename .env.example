# ── PolicyPilot Environment Variables ─────────────────────────────
# Copy this file to .env.local (frontend) or .env (backend) and fill in real values.
# Never commit files containing real secrets.

# ── Frontend (frontend/.env.local) ────────────────────────────────
# Public API base URL served to the browser (must start with NEXT_PUBLIC_)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Backend (root .env) ───────────────────────────────────────────
# OpenAI-compatible LLM API
OPENAI_API_KEY=sk-...

# Embedding model name
EMBEDDING_MODEL=text-embedding-3-small

# LLM model name
LLM_MODEL=gpt-4o-mini

# Supabase project credentials (backend only — never expose to browser)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
POLICY_STORAGE_BUCKET=policy-documents

# ChromaDB settings (used during local development)
CHROMA_HOST=localhost
CHROMA_PORT=8001
